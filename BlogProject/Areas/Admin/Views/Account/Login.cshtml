@model BlogProject.Areas.Admin.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Gazetary — Admin Girişi</title>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@700&family=Lato:wght@400;700;900&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: '#1152d4' },
                    fontFamily: {
                        display: ['"EB Garamond"', 'Georgia', 'serif'],
                        sans:    ['"Lato"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen bg-[#f6f6f4] flex items-center justify-center px-4 font-sans antialiased">

    <div class="w-full max-w-[400px]">

        <div class="text-center mb-8">
            <a href="/" class="text-4xl font-display font-bold text-[#111318] tracking-tight">
                Gazetary
            </a>
            <div class="mt-3 flex items-center justify-center gap-2">
                <div class="h-px w-12 bg-neutral-300"></div>
                <span class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-neutral-400">
                    Admin Paneli
                </span>
                <div class="h-px w-12 bg-neutral-300"></div>
            </div>
        </div>

        <div class="bg-white border border-neutral-200 shadow-sm">

            <div class="border-b border-neutral-100 px-8 py-5">
                <h1 class="text-lg font-sans font-bold text-[#111318]">Giriş Yap</h1>
                <p class="text-xs text-neutral-400 font-sans mt-0.5">Yönetim paneline erişmek için giriş yapın.</p>
            </div>

            <div class="px-8 py-6">

                @if (ViewBag.Error != null)
                {
                    <div class="flex items-center gap-2 px-4 py-3 bg-red-50 border border-red-200 mb-5">
                        <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <p class="text-sm text-red-600 font-sans">@ViewBag.Error</p>
                    </div>
                }

                <form method="post" class="flex flex-col gap-5">
                    @Html.AntiForgeryToken()
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[11px] font-sans font-bold uppercase tracking-wider text-neutral-500">
                            E-posta
                        </label>
                        <input asp-for="Email"
                               type="email"
                               placeholder="admin@gazetary.com"
                               required
                               autocomplete="email"
                               class="w-full px-4 py-2.5 border border-neutral-300 bg-white text-sm font-sans text-[#111318] focus:outline-none focus:border-primary transition-colors placeholder:text-neutral-300" />
                        <span asp-validation-for="Email" class="text-red-500 text-xs font-sans"></span>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-[11px] font-sans font-bold uppercase tracking-wider text-neutral-500">
                            Şifre
                        </label>
                        <div class="relative">
                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   placeholder="••••••••"
                                   required
                                   autocomplete="current-password"
                                   class="w-full px-4 py-2.5 pr-10 border border-neutral-300 bg-white text-sm font-sans text-[#111318] focus:outline-none focus:border-primary transition-colors placeholder:text-neutral-300" />
                            <button type="button"
                                    onclick="togglePass()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600 transition-colors">
                                <svg id="eyeIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs font-sans"></span>
                    </div>

                    <button type="submit"
                            class="w-full py-2.5 bg-[#111318] text-white text-xs font-sans font-bold uppercase tracking-widest hover:bg-neutral-800 active:bg-neutral-900 transition-colors mt-1">
                        Giriş Yap
                    </button>

                </form>
            </div>
        </div>

        <div class="mt-6 text-center">
            <a href="/"
               class="text-xs text-neutral-400 font-sans hover:text-neutral-600 transition-colors flex items-center justify-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Siteye Dön
            </a>
        </div>

        <p class="text-center text-[10px] text-neutral-300 font-sans mt-8 tracking-wide">
            © @DateTime.Now.Year Gazetary
        </p>

    </div>

</body>

<script>
    function togglePass() {
        const input = document.getElementById('passwordInput');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.innerHTML = `
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`;
        } else {
            input.type = 'password';
            icon.innerHTML = `
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
        }
    }
</script>
</html>
