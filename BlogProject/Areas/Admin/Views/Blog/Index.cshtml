@model dynamic

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white dark:bg-background-dark p-6 rounded-xl border border-[#dbe0e6] dark:border-gray-800 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-[#617589] text-sm font-medium">Total Published</p>
            <span class="material-symbols-outlined text-primary">check_circle</span>
        </div>
        <p class="text-3xl font-bold dark:text-white">1,248</p>
        <p class="text-xs text-green-600 font-medium mt-2 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">trending_up</span>
            +12 this week
        </p>
    </div>
    <div class="bg-white dark:bg-background-dark p-6 rounded-xl border border-[#dbe0e6] dark:border-gray-800 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-[#617589] text-sm font-medium">Pending Drafts</p>
            <span class="material-symbols-outlined text-gray-400">edit_note</span>
        </div>
        <p class="text-3xl font-bold dark:text-white">42</p>
        <p class="text-xs text-[#617589] font-medium mt-2">Requires review</p>
    </div>
    <div class="bg-white dark:bg-background-dark p-6 rounded-xl border border-[#dbe0e6] dark:border-gray-800 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-[#617589] text-sm font-medium">Scheduled</p>
            <span class="material-symbols-outlined text-orange-400">schedule</span>
        </div>
        <p class="text-3xl font-bold dark:text-white">15</p>
        <p class="text-xs text-[#617589] font-medium mt-2">To be published today</p>
    </div>
</div>
<div class="bg-white dark:bg-background-dark rounded-xl border border-[#dbe0e6] dark:border-gray-800 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-[#dbe0e6] dark:border-gray-800 flex flex-wrap gap-3 items-center justify-between">
