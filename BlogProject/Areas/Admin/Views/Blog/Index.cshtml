            <button class="flex h-9 items-center gap-2 rounded-lg bg-background-light dark:bg-gray-800 px-4 text-sm font-medium border border-[#dbe0e6] dark:border-gray-700">
                <span>All Categories</span>
                <span class="material-symbols-outlined text-sm">expand_more</span>
            </button>
            <button class="flex h-9 items-center gap-2 rounded-lg bg-background-light dark:bg-gray-800 px-4 text-sm font-medium border border-[#dbe0e6] dark:border-gray-700">
                <span>Status</span>
                <span class="material-symbols-outlined text-sm">expand_more</span>
            </button>
        </div>
        <div class="text-[#617589] text-sm font-medium">
            Showing 1-10 of 1,248 posts
        </div>
    </div>
