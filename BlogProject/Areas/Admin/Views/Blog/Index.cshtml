@model List<Entities.Concrate.BlogPost>

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Blog/</span> Blog Yazıları</h4>
<div class="card">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Başlık</th>
                <th>Kategori</th>
                <th>Durum</th>
                <th style="width: 180px;">İşlemler</th>
            </tr>
            </thead>
            <tbody class="table-border-bottom-0">
            @foreach (var item in Model)
            {
                <tr>
                    <td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@item.Title</strong></td>
                    <td>@item.Category.CategoryName</td>
                    <td>
                        @if (@item.Status == true)
                        {
                            <span class="badge bg-label-success me-1">Yayında</span>
                        }
                        else
                        {
                            <span class="badge bg-label-warning me-1">Taslak</span>
                        }
                    </td>
                    <td>
                        <a href="javascript:void(0);" class="btn btn-sm btn-outline-primary me-1" title="Güncelle">
                            <i class="bx bx-edit-alt"></i>
                        </a>
                        <a href="javascript:void(0);" class="btn btn-sm btn-outline-danger me-1" title="Sil">
                            <i class="bx bx-trash"></i>
                        </a>
                        @if (@item.Status == true)
                        {
                            <a href="javascript:void(0);" class="btn btn-sm btn-outline-secondary" title="Taslağa Al">
                                <i class="bx bx-archive"></i>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:void(0);" class="btn btn-sm btn-outline-success" title="Yayınla">
                                <i class="bx bx-check-circle"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>