@model List<Entities.Concrate.Category>

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Kategoriler/</span> Kategori Listesi</h4>
    </div>
    <div class="col-md-6">
        <a href="/Admin/Category/CreateCategory" class="btn btn-primary float-end">Yeni Kategori Ekle</a>
    </div>
</div>
<div class="card">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Kategori</th>
                <th>Kısa Ad</th>
                <th>Durum</th>
                <th style="width: 180px;">İşlemler</th>
            </tr>
            </thead>
            <tbody class="table-border-bottom-0">
            @foreach (var item in Model)
            {
                <tr>
                    <td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@item.CategoryName</strong></td>
                    <td>@item.CategorySlug</td>
                    <td>
                        @if (@item.IsStatus == true)
                        {
                            <span class="badge bg-label-success me-1">Yayında</span>
                        }
                        else
                        {
                            <span class="badge bg-label-warning me-1">Taslak</span>
                        }
                    </td>
                    <td>
                        <a href="~/Admin/Category/Editcategory/@item.CategoryId" class="btn btn-sm btn-outline-primary me-1" title="Güncelle">
                            <i class="bx bx-edit-alt"></i>
                        </a>
                        <a href="~/Admin/Category/DeleteCategory/@item.CategoryId" class="btn btn-sm btn-outline-danger me-1" title="Sil">
                            <i class="bx bx-trash"></i>
                        </a>
                        @if (@item.IsStatus == true)
                        {
                            <a href="javascript:void(0);" class="btn btn-sm btn-outline-secondary" title="Taslağa Al">
                                <i class="bx bx-archive"></i>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:void(0);" class="btn btn-sm btn-outline-success" title="Yayınla">
                                <i class="bx bx-check-circle"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>