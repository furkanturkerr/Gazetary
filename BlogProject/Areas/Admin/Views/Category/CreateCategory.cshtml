@model Entities.Concrate.Category

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="w-full space-y-6">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-gray-900 p-6 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
        <div class="flex items-center gap-4">
            <a href="/Admin/Category/Index" class="group p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">
                <span class="material-symbols-outlined text-gray-500 group-hover:text-primary">arrow_back</span>
            </a>
            <div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">Yeni Kategori Ekle</h2>
                <p class="text-xs text-gray-500">Sistem için yeni tanımlama yapın</p>
            </div>
        </div>
        
        <div class="flex items-center gap-2">
            
        </div>
    </div>

    <form method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white dark:bg-gray-900 p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
                <div class="grid grid-cols-1 gap-8">
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2">Kategori Adı</label>
                        <input type="text" asp-for="CategoryName" required
                               class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2">URL Uzantısı (Slug)</label>
                        <div class="flex shadow-sm">
                            <input type="text" asp-for="CategorySlug" required
                                   class="flex-1 px-4 py-3 rounded-r-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-mono text-sm">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="btn btn-outline-info">Kaydet</button>
    </form>
</div>