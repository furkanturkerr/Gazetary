@model Entities.Concrate.Category

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Kategoriler/</span> Kategori Güncelle</h4>
<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-body">
                <div>
                    <form method="post">
                        <input type="hidden" asp-for="CategoryId"/>
                        <label class="form-label">Kategori Adı</label>
                        <input asp-for="CategoryName" type="text" class="form-control"/>
                        <br/>
                        <label class="form-label">Kategori Kısa Adı</label>
                        <input asp-for="CategorySlug" type="text" class="form-control"/>
                        <br/>
                        <button class="btn btn-dark">Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>