@model List<Entities.Concrate.Comment>

@{
    Layout = "~/Views/Admin/Index.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string selectedPost = ViewBag.SelectedPost ?? "";
    var allPosts = ViewBag.AllPosts as List<Entities.Concrate.BlogPost> ?? new List<Entities.Concrate.BlogPost>();
}

<div class="d-flex align-items-center justify-content-between py-3 mb-4">
    <h4 class="fw-bold mb-0">
        <span class="text-muted fw-light">Yorumlar /</span> Yorum Listesi
        <span class="badge bg-label-primary ms-2">@ViewBag.TotalCount</span>
    </h4>
</div>

@* Blog Yazısına Göre Filtre *@
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/Admin/Comment/CommentList">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-semibold mb-1">Blog Yazısına Göre Filtrele</label>
                    <select name="postId" class="form-select" onchange="this.form.submit()">
                        <option value="">— Tüm Yazılar —</option>
                        @foreach (var post in allPosts)
                        {
                            if (selectedPost == post.BlogPostId.ToString())
                            {
                                <option value="@post.BlogPostId" selected>@post.Title</option>
                            }
                            else
                            {
                                <option value="@post.BlogPostId">@post.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bx bx-filter-alt me-1"></i> Filtrele
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="/Admin/Comment/CommentList" class="btn btn-outline-secondary w-100">
                        <i class="bx bx-reset me-1"></i> Temizle
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@* Tablo *@
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Yazı Başlığı</th>
                    <th>Yazar</th>
                    <th>Yorum</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-center pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bx bx-comment-x d-block mb-2" style="font-size:2rem;"></i>
                            Bu yazıya ait yorum bulunamadı.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-semibold" style="max-width:220px; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                @(item.BlogPost?.Title ?? "—")
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-label-info">@item.Name</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Content) && item.Content.Length > 50)
                            {
                                <span data-bs-toggle="tooltip" title="@item.Content"
                                      style="max-width:200px; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:help;">
                                    @item.Content.Substring(0, 50)…
                                </span>
                            }
                            else
                            {
                                @item.Content
                            }
                        </td>
                        <td class="text-muted small">@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @* IsStatus eklenince aktif edilecek *@
                            <span class="badge bg-label-warning">Taslak</span>
                        </td>
                        <td class="text-center pe-4">
                            <div class="d-flex justify-content-center gap-1">
                                <a href="/Admin/Comment/EditComment/@item.CommentId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Düzenle">
                                    <i class="bx bx-edit-alt"></i>
                                </a>
                                <a href="/Admin/Comment/DeleteComment/@item.CommentId"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Sil"
                                   onclick="return confirm('Bu yorumu silmek istediğinizden emin misiniz?')">
                                    <i class="bx bx-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination *@
    @if (totalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted small">Sayfa <strong>@currentPage</strong> / <strong>@totalPages</strong></span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(currentPage - 1)&postId=@selectedPost">
                        <i class="bx bx-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&postId=@selectedPost">@i</a>
                        </li>
                    }
                    else if (i == currentPage - 3 || i == currentPage + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(currentPage + 1)&postId=@selectedPost">
                        <i class="bx bx-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<script>
    document.querySelectorAll('[data-bs-toggle="tooltip"]')
        .forEach(el => new bootstrap.Tooltip(el))
</script>