@model List<Entities.Concrate.Contact>

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">
        <span class="text-muted fw-light">İletişim / </span>Mesajlar
        @{
            var unreadCount = Model.Count(x => !x.IsRead);
        }
        @if (unreadCount > 0)
        {
            <span class="badge bg-danger ms-2">@unreadCount Yeni</span>
        }
    </h4>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:16px"></th>
                    <th>Gönderen</th>
                    <th>Konu</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-end" style="width:120px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(x => x.CreatedDate))
                {
                    <tr class="@(!item.IsRead ? "table-warning" : "")" style="cursor:pointer"
                        onclick="window.location='/Admin/Contact/Detail/@item.ContactId'">
                        <td>
                            @if (!item.IsRead)
                            {
                                <span class="d-block rounded-circle bg-danger"
                                      style="width:8px;height:8px"></span>
                            }
                        </td>
                        <td>
                            <div class="fw-@(!item.IsRead ? "bold" : "normal")">@item.NameSurname</div>
                            <small class="text-muted">@item.Email</small>
                        </td>
                        <td class="fw-@(!item.IsRead ? "bold" : "normal")">
                            @item.Subject
                        </td>
                        <td>
                            <span class="d-block">@item.CreatedDate.ToString("dd MMM yyyy")</span>
                            <small class="text-muted">@item.CreatedDate.ToString("HH:mm")</small>
                        </td>
                        <td>
                            @if (item.IsRead)
                            {
                                <span class="badge bg-label-success">Okundu</span>
                            }
                            else
                            {
                                <span class="badge bg-label-warning">Okunmadı</span>
                            }
                        </td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            <div class="d-flex justify-content-end gap-1">
                                <a href="/Admin/Contact/Detail/@item.ContactId"
                                   class="btn btn-sm btn-icon btn-outline-primary"
                                   title="Görüntüle">
                                    <i class="bx bx-show"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.ContactId" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-icon btn-outline-danger"
                                        title="Sil"
                                        onclick="return confirm('Bu yazıyı silmek istediğinizden emin misiniz?')">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bx bx-inbox fs-2 d-block mb-2 opacity-50"></i>
                            Henüz mesaj yok.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
