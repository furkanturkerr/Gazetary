@model BlogProject.Areas.Admin.Models.ImageViewModel

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <label>Görsel</label>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label class="form-label">Dosyadan Yükle</label>
        <input type="file"
               asp-for="Image"
               class="form-control"
               accept="image/*"
               required/>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-outline-warning">
            <i class="fas fa-save"></i> Kaydet
        </button>
        <a href="~/Images/Index" class="btn btn-outline-secondary">
            <i class="fas fa-times"></i> İptal
        </a>
    </div>
</form>