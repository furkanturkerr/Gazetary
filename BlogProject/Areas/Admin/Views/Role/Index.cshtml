@model List<Entities.Concrate.AppRole>

@{
    Layout = "~/Views/Admin/Index.cshtml";

}

<div class="container">
    <table class="table-bordered">
        <tr>
            <th>Role Adı</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
        <tr>
            @foreach (var item in Model)
            {
                <td>@item.Name</td>
                <td><a href="" class="btn btn-success">Sil</a></td>
                <td><a href="" class="btn btn-success">Güncelle</a></td>
            }
        </tr>
    </table>
</div>