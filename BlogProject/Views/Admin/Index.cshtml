@model dynamic

@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="en">

@await Component.InvokeAsync("_AdminHeadComponentPartial")
<body class="bg-background-light dark:bg-background-dark text-[#111418] dark:text-white min-h-screen">
<div class="flex h-screen overflow-hidden">

    @await Component.InvokeAsync("_AdminSidebarComponentPartial")

    <main class="flex-1 flex flex-col overflow-hidden bg-background-light dark:bg-background-dark">
        @await Component.InvokeAsync("_AdminHeaderComponentPartial")
        <div class="flex-1 overflow-y-auto p-8">
            @RenderBody()
        </div>
    </main>
</div>
</body>
</html>