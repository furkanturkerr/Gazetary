@model Entities.Concrate.Contact
@{
    Layout = "~/Views/UILayout/Home.cshtml";
    ViewBag.Title = "İletişim";
}

<div class="max-w-3xl mx-auto py-12 px-4">

    <div class="border-b-2 border-black dark:border-white pb-3 mb-8">
        <p class="text-[10px] font-sans font-bold uppercase tracking-widest text-primary mb-1">Kurumsal</p>
        <h1 class="text-4xl font-display font-bold text-[#111318] dark:text-white">İletişim</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 px-4 py-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 mb-6">
            <span class="material-symbols-outlined text-green-600 text-[20px]">check_circle</span>
            <p class="text-sm font-sans text-green-700 dark:text-green-400">@TempData["Success"]</p>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">

        <!-- Form -->
        <div>
            <h2 class="text-lg font-display font-bold mb-5 text-[#111318] dark:text-white">Bize Yazın</h2>
            <form method="post" asp-controller="Contact" asp-action="Iletisim" class="flex flex-col gap-4">
                <div>
                    <label class="block text-xs font-sans font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-1.5">Ad Soyad</label>
                    <input type="text"
                           asp-for="NameSurname"
                           required
                           placeholder="Adınız ve soyadınız"
                           class="w-full px-3 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm font-sans text-[#111318] dark:text-white focus:outline-none focus:border-primary transition-colors" />
                </div>
                <div>
                    <label class="block text-xs font-sans font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-1.5">E-posta</label>
                    <input type="email"
                           asp-for="Email"
                           required
                           placeholder="ornek@mail.com"
                           class="w-full px-3 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm font-sans text-[#111318] dark:text-white focus:outline-none focus:border-primary transition-colors" />
                </div>
                <div>
                    <label class="block text-xs font-sans font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-1.5">Konu</label>
                    <select asp-for="Subject"
                            class="w-full px-3 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm font-sans text-[#111318] dark:text-white focus:outline-none focus:border-primary transition-colors">
                        <option value="">Konu seçin</option>
                        <option value="genel">Genel</option>
                        <option value="icerik">İçerik Önerisi</option>
                        <option value="reklam">Reklam & İşbirliği</option>
                        <option value="duzeltme">Düzeltme Talebi</option>
                        <option value="diger">Diğer</option>
                    </select>
                    <span asp-validation-for="Subject" class="text-red-500 text-xs font-sans"></span>
                </div>
                <div>
                    <label class="block text-xs font-sans font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-1.5">Mesaj</label>
                    <textarea asp-for="Message"
                              required
                              rows="5"
                              placeholder="Mesajınızı buraya yazın..."
                              class="w-full px-3 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm font-sans text-[#111318] dark:text-white focus:outline-none focus:border-primary transition-colors resize-none"></textarea>
                </div>
                <button type="submit"
                        class="w-full py-3 bg-primary text-white text-xs font-sans font-bold uppercase tracking-widest hover:bg-blue-700 transition-colors">
                    Gönder
                </button>
            </form>
        </div>
        
        @if (TempData["Basarili"] != null)
        {
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
        const Toast = Swal.mixin({
            toast: true,
            position: "top-end",
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.onmouseenter = Swal.stopTimer;
                toast.onmouseleave = Swal.resumeTimer;
            }
        });

        Toast.fire({
            icon: "success",
            title: "@TempData["Basarili"]"
        });
    </script>
        }

        <!-- Bilgi -->
        <div class="flex flex-col gap-6">
            <h2 class="text-lg font-display font-bold text-[#111318] dark:text-white">İletişim Bilgileri</h2>

            <div class="flex flex-col gap-5">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-[20px] mt-0.5">mail</span>
                    <div>
                        <p class="text-[10px] font-sans font-bold uppercase tracking-wider text-neutral-400 mb-0.5">E-posta</p>
                        <a href="gazetarycom@gmail.com" class="text-sm font-sans text-[#111318] dark:text-white hover:text-primary transition-colors">info@gazetary.com</a>
                    </div>
                </div>
            </div>

            <div class="border-t border-neutral-200 dark:border-neutral-800 pt-5 mt-2">
                <p class="text-[10px] font-sans font-bold uppercase tracking-wider text-neutral-400 mb-3">Sosyal Medya</p>
                <div class="flex gap-3">
                    <a href="#" class="w-8 h-8 flex items-center justify-center border border-neutral-300 dark:border-neutral-700 text-neutral-500 hover:border-primary hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[16px]">public</span>
                    </a>
                    <a href="#" class="w-8 h-8 flex items-center justify-center border border-neutral-300 dark:border-neutral-700 text-neutral-500 hover:border-primary hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[16px]">rss_feed</span>
                    </a>
                    <a href="#" class="w-8 h-8 flex items-center justify-center border border-neutral-300 dark:border-neutral-700 text-neutral-500 hover:border-primary hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[16px]">photo_camera</span>
                    </a>
                </div>
            </div>

            <div class="bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-4 mt-2">
                <p class="text-xs font-sans text-neutral-500 dark:text-neutral-400 leading-relaxed">
                    Mesajlara genellikle <strong class="text-[#111318] dark:text-white">1–2 iş günü</strong> içinde yanıt verilmektedir.
                </p>
            </div>
        </div>

    </div>
</div>
