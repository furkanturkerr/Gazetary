@model dynamic

@{
    Layout = "~/Views/UILayout/Home.cshtml";
}

@await Component.InvokeAsync("_HomeEditorPick")

<div class="grid grid-cols-12 gap-8 lg:gap-10 mt-10">

    <div class="col-span-12 lg:col-span-9 flex flex-col gap-10">
        @await Component.InvokeAsync("_HomeCategoryWithTurkiye")
        @await Component.InvokeAsync("_HomeCategoryWithEconomy")
    </div>

    <div class="col-span-12 lg:col-span-3">
        @await Component.InvokeAsync("_HomeMostRead")
    </div>

</div>

<div class="mt-10">
    @await Component.InvokeAsync("_HomeCategoryWithSpor")
    @await Component.InvokeAsync("_HomeCategoryWithTechnology")
    @await Component.InvokeAsync("_HomeCategoryWithHistory")
    @await Component.InvokeAsync("_HomeCategoryWithSoftware")
</div>

@section scripts {
    <script src="~/js/home-editorPick.js"></script>
}