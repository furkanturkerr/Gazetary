                    <div class="w-full sm:w-48 h-32 shrink-0 bg-gray-100 relative border border-gray-200">
                        <div class="absolute inset-0 bg-cover bg-center" data-alt="Close up of a film camera lens" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAyPK7BAZnbm13-clOM5MHX6xZZ0Lwr6I3VldqTAQqyz9vm64Iqtz1kluiFoTASWE08if3YWu3BclIgUvoK_SD1fmNSSF5CS-9ZSUJPP0OHGU7tocsJkM5j9ajNvLiOtrZ3UfyKan-YYUpjbk85-1KEoj6938zRHgGz1tCox5E-XhUoTD94JUOIa-Fbnu2byFCsQ9t3ecsUs_N1lUAvftHVaMvx8Dn7hpeOCKjrekd6Fxq64PAN9jsszbflKzt5TtFBMrMzedMCBjY");'></div>
