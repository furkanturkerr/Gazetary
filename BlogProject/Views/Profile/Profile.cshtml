<body class="min-h-screen flex flex-col font-display text-[#111318] antialiased">
<div class="w-full max-w-[1120px] mx-auto bg-white min-h-screen shadow-sm border-x border-[#e5e7eb] flex flex-col relative">
    <header class="border-b border-[#f0f2f4] px-8 py-5 relative">
        <div class="flex items-center justify-between h-12">
