            </div>
            <div class="flex items-center gap-5 z-10">
                <div class="hidden lg:flex items-center border-b border-gray-300 hover:border-black transition-colors px-1 pb-1 w-48">
                    <span class="material-symbols-outlined text-[#616f89] text-[20px]">search</span>
                    <input class="bg-transparent border-none p-0 px-2 focus:ring-0 text-sm w-full font-sans placeholder-[#616f89]" placeholder="Haber ara..." type="text"/>
