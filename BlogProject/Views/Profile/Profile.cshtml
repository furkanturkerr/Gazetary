                    <span class="material-symbols-outlined cursor-pointer text-2xl">menu</span>
                </div>
                <nav class="hidden md:flex items-center gap-6">
                    <a class="text-[#111318] text-sm font-bold font-sans hover:text-primary transition-colors uppercase tracking-tight" href="#">Gündem</a>
                    <a class="text-[#111318] text-sm font-bold font-sans hover:text-primary transition-colors uppercase tracking-tight" href="#">Dünya</a>
