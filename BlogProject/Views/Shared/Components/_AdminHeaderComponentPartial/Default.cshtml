<header class="flex items-center justify-between border-b border-[#dbe0e6] dark:border-gray-800 bg-white dark:bg-background-dark px-8 py-4 shrink-0">
    <div class="flex flex-col">
        <div class="flex items-center gap-2 text-xs text-[#617589] font-medium mb-1">
            <span>Dashboard</span>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-[#111418] dark:text-gray-300">Posts</span>
        </div>
        <h2 class="text-[#111418] dark:text-white text-xl font-bold tracking-tight">All Posts</h2>
    </div>
    <div class="flex items-center gap-4">
        <label class="relative hidden md:block">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-[#617589]">
                <span class="material-symbols-outlined text-lg">search</span>
            </span>
            <input class="w-64 h-10 pl-10 pr-4 bg-background-light dark:bg-gray-800 border-none rounded-lg text-sm focus:ring-2 focus:ring-primary/20 placeholder:text-[#617589]" placeholder="Search headlines..." type="text"/>
        </label>
        <div class="h-8 w-px bg-[#dbe0e6] dark:bg-gray-800 mx-2"></div>
        <button class="flex items-center justify-center size-10 rounded-lg bg-background-light dark:bg-gray-800 text-[#111418] dark:text-white">
            <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg font-bold text-sm hover:bg-primary/90 transition-colors shadow-sm">
            <span class="material-symbols-outlined text-lg">add</span>
            <span>Create New</span>
        </button>
    </div>
</header>