@model List<Entities.Concrate.BlogPost>

<section class="hc-section">
    <div class="hc-header">
        <h2 class="hc-title">Yazılım</h2>
        <a href="/yazilim" class="hc-more">Tümünü Görüntüle &rsaquo;</a>
    </div>

    <div class="hc-yazilim-grid">
        @for (int i = 0; i < Model.Count && i < 3; i++)
        {
            <a href="/yazilim/@Model[i].Slug" class="hc-yazilim-card @(i > 0 ? "hc-yazilim-card--bordered" : "")">
                <div class="hc-yazilim-img-wrap">
                    <img src="@Model[i].ImageUrl" alt="@Model[i].Title" class="hc-yazilim-img" />
                </div>
                <div class="hc-yazilim-body">
                    <span class="hc-kicker">@Model[i].Category.CategoryName</span>
                    <h3 class="hc-hed-sm">@Model[i].Title</h3>
                    <p class="hc-summary">@Model[i].Description</p>
                    <span class="hc-byline">@Model[i].CreatedDate.ToString("dd MMM yyyy")</span>
                </div>
            </a>
        }
    </div>
</section>