<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NYW9WM7EN7"></script>
    <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-NYW9WM7EN7');
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="index, follow"/>
    <meta name="theme-color" content="#1152d4"/>

    <link rel="stylesheet" href="~/css/home-categories.css"/>
    <link rel="stylesheet" href="~/css/home-editorPick.css"/>

    <link rel="icon" type="image/png" href="~/favicon/favicon-96x96.png" sizes="96x96"/>
    <link rel="icon" type="image/svg+xml" href="~/favicon/favicon.svg"/>
    <link rel="shortcut icon" href="~/favicon.ico"/>
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon/apple-touch-icon.png"/>
    <link rel="manifest" href="~/favicon/site.webmanifest"/>

    @if (ViewBag.MetaTitle != null)
    {
        <title>@ViewBag.MetaTitle — Gazetary</title>
        <meta name="description" content="@ViewBag.MetaDesc"/>
        <meta name="keywords" content="@ViewBag.MetaKeywords"/>
        <meta name="author" content="Gazetary"/>
        <link rel="canonical" href="@ViewBag.CanonicalUrl"/>

        <meta property="og:title" content="@ViewBag.MetaTitle"/>
        <meta property="og:description" content="@ViewBag.MetaDesc"/>
        <meta property="og:image" content="@(ViewBag.OgImage ?? "https://gazetary.com/img/og-image.jpg")"/>
        <meta property="og:url" content="@ViewBag.CanonicalUrl"/>
        <meta property="og:type" content="@(ViewBag.OgType ?? "website")"/>
        <meta property="og:site_name" content="Gazetary"/>
        <meta property="og:locale" content="tr_TR"/>

        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content="@ViewBag.MetaTitle"/>
        <meta name="twitter:description" content="@ViewBag.MetaDesc"/>
        <meta name="twitter:image" content="@(ViewBag.OgImage ?? "https://gazetary.com/img/og-image.jpg")"/>

        @if (ViewBag.OgType == "article")
        {
            <meta property="article:published_time" content="@ViewBag.PublishedTime"/>
            <meta property="article:section" content="@ViewBag.ArticleSection"/>

            <script type="application/ld+json">
            {
                "@@context":     "https://schema.org",
                "@@type":        "Article",
                "headline":      "@ViewBag.MetaTitle",
                "description":   "@ViewBag.MetaDesc",
                "image":         "@ViewBag.OgImage",
                "url":           "@ViewBag.CanonicalUrl",
                "datePublished": "@ViewBag.PublishedTime",
                "inLanguage":    "tr",
                "publisher": {
                    "@@type": "Organization",
                    "name":   "Gazetary",
                    "url":    "https://gazetary.com"
                }
            }
            </script>
        }
    }
    else
    {
        <title>Gazetary.com</title>
        <meta name="description" content="Gazetary ile teknoloji, yazılım, yapay zeka, ekonomi ve Türkiye'den güncel haberleri takip edin."/>
        <meta name="keywords" content="teknoloji haberleri, yazılım haberleri, yapay zeka, ekonomi, spor, türkiye haberleri, gazetary"/>
        <meta name="author" content="Gazetary"/>
        <link rel="canonical" href="https://gazetary.com"/>

        <meta property="og:title" content="Gazetary.com"/>
        <meta property="og:description" content="Gazetary ile teknoloji, yazılım, yapay zeka ve güncel haberlerden haberdar olun."/>
        <meta property="og:image" content="https://gazetary.com/img/og-image.jpg"/>
        <meta property="og:url" content="https://gazetary.com"/>
        <meta property="og:type" content="website"/>
        <meta property="og:site_name" content="Gazetary"/>
        <meta property="og:locale" content="tr_TR"/>

        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content="Gazetary.com"/>
        <meta name="twitter:description" content="Gazetary ile teknoloji, yazılım, yapay zeka ve güncel haberlerden haberdar olun."/>
        <meta name="twitter:image" content="https://gazetary.com/img/og-image.jpg"/>

        <script type="application/ld+json">
        {
            "@@context":   "https://schema.org",
            "@@type":      "WebSite",
            "name":        "Gazetary",
            "url":         "https://gazetary.com",
            "description": "Türkiye'den teknoloji, yazılım ve güncel haberler",
            "inLanguage":  "tr",
            "potentialAction": {
                "@@type":      "SearchAction",
                "target":      "https://gazetary.com/arama?q={search_term_string}",
                "query-input": "required name=search_term_string"
            }
        }
        </script>
    }

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary":          "#1152d4",
                        "background-light": "#f9f9fb",
                        "background-dark":  "#101622",
                    },
                    fontFamily: {
                        "display": ["Newsreader", "serif"],
                        "sans":    ["Noto Sans", "sans-serif"]
                    },
                },
            },
        }
    </script>

    <style type="text/tailwindcss">
        ::-webkit-scrollbar        { width: 8px; }
        ::-webkit-scrollbar-track  { background: transparent; }
        ::-webkit-scrollbar-thumb  { background: #cbd5e1; border-radius: 4px; }
        .article-content p         { margin-bottom: 1.5rem; font-size: 1.125rem; line-height: 1.8; color: #374151; }
        .dark .article-content p   { color: #d1d5db; }
        .article-content h2        { font-size: 1.5rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; color: #111318; }
        .dark .article-content h2  { color: #fff; }
        .article-content h3        { font-size: 1.25rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #111318; }
        .article-content ul,
        .article-content ol        { margin-bottom: 1.5rem; padding-left: 1.5rem; }
        .article-content li        { margin-bottom: 0.5rem; font-size: 1.125rem; line-height: 1.8; color: #374151; }
        .article-content a         { color: #1152d4; text-decoration: underline; }
        .article-content blockquote { border-left: 3px solid #1152d4; padding-left: 1rem; margin: 1.5rem 0; font-style: italic; color: #6b7280; }
        .article-content img       { max-width: 100%; border-radius: 0.25rem; margin: 1.5rem 0; }
    </style>
</head>
