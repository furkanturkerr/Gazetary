<header class="flex flex-col border-b border-[#e5e7eb] dark:border-neutral-700">
        <div class="flex items-center justify-between px-8 py-2 border-b border-[#f3f4f6] dark:border-neutral-800">
            <div class="text-xs font-sans text-neutral-500 dark:text-neutral-400 font-medium">
                @DateTime.Now
            </div>
            <div class="flex items-center gap-4 text-xs font-sans font-medium text-neutral-600 dark:text-neutral-400">
                <span class="flex items-center gap-1"><span class="text-green-600 material-symbols-outlined text-[16px]">trending_up</span> USD: 28.14</span>
                <span class="flex items-center gap-1"><span class="text-red-600 material-symbols-outlined text-[16px]">trending_down</span> EUR: 29.82</span>
                <span class="flex items-center gap-1 ml-4"><span class="material-symbols-outlined text-[16px]">wb_sunny</span> İstanbul 18°C</span>
            </div>
            <div class="flex items-center gap-4">
                <a class="text-xs font-bold text-neutral-900 dark:text-white hover:text-primary transition-colors" href="#">Giriş Yap</a>
                <button class="bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs px-3 py-1.5 font-bold tracking-wide uppercase">Abone Ol</button>
            </div>
        </div>
        <div class="flex items-center justify-center py-6 relative px-8">
            <button class="absolute left-8 p-2 text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <h1 class="text-5xl font-black tracking-tighter text-[#111318] dark:text-white font-display">GAZETE</h1>
            <div class="absolute right-8 flex items-center">
                <button class="p-2 text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded">
                    <span class="material-symbols-outlined">search</span>
                </button>
            </div>
        </div>
        <nav class="flex items-center justify-center gap-8 py-3 border-t border-black dark:border-white border-double border-b-0 border-t-[3px]">
            <a class="text-[#1152d4] text-sm font-bold uppercase tracking-wider border-b-2 border-[#1152d4] pb-0.5" href="#">Anasayfa</a>
            <a class="text-neutral-600 dark:text-neutral-300 hover:text-[#111318] dark:hover:text-white text-sm font-bold uppercase tracking-wider transition-colors" href="#">Yazılım</a>
            <a class="text-neutral-600 dark:text-neutral-300 hover:text-[#111318] dark:hover:text-white text-sm font-bold uppercase tracking-wider transition-colors" href="#">Teknoloji</a>
            <a class="text-neutral-600 dark:text-neutral-300 hover:text-[#111318] dark:hover:text-white text-sm font-bold uppercase tracking-wider transition-colors" href="#">Oyun</a>
            <a class="text-neutral-600 dark:text-neutral-300 hover:text-[#111318] dark:hover:text-white text-sm font-bold uppercase tracking-wider transition-colors" href="#">Sğpor</a>
            <a class="text-neutral-600 dark:text-neutral-300 hover:text-[#111318] dark:hover:text-white text-sm font-bold uppercase tracking-wider transition-colors" href="#">Teknoloji</a>
            <a class="text-neutral-600 dark:text-neutral-300 hover:text-[#111318] dark:hover:text-white text-sm font-bold uppercase tracking-wider transition-colors" href="#">Tarih</a>
        </nav>
    </header>