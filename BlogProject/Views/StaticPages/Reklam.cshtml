@{
    Layout = "~/Views/UILayout/Home.cshtml";
    ViewBag.Title = "Reklam & İşbirliği";
}

<div class="max-w-2xl mx-auto py-12 px-4">

    <div class="border-b-2 border-black dark:border-white pb-3 mb-8">
        <p class="text-[10px] font-sans font-bold uppercase tracking-widest text-primary mb-1">Kurumsal</p>
        <h1 class="text-4xl font-display font-bold text-[#111318] dark:text-white">Reklam & İşbirliği</h1>
    </div>

    <div class="space-y-8 font-sans text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">

        <p class="text-base font-display text-[#111318] dark:text-white leading-relaxed">
            Gazetary, teknoloji ve yazılım alanında oluşturduğu güçlü okuyucu kitlesiyle markanızı doğru hedef kitleyle buluşturmak için ideal bir platformdur.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="border border-neutral-200 dark:border-neutral-800 p-5 text-center">
                <p class="text-3xl font-display font-bold text-primary mb-1">10K+</p>
                <p class="text-xs font-bold uppercase tracking-wider text-neutral-400">Aylık Okuyucu</p>
            </div>
            <div class="border border-neutral-200 dark:border-neutral-800 p-5 text-center">
                <p class="text-3xl font-display font-bold text-primary mb-1">%78</p>
                <p class="text-xs font-bold uppercase tracking-wider text-neutral-400">Teknik Profil</p>
            </div>
            <div class="border border-neutral-200 dark:border-neutral-800 p-5 text-center">
                <p class="text-3xl font-display font-bold text-primary mb-1">4.2dk</p>
                <p class="text-xs font-bold uppercase tracking-wider text-neutral-400">Ort. Sayfa Süresi</p>
            </div>
        </div>

        <div class="space-y-4">
            <h2 class="text-lg font-display font-bold text-[#111318] dark:text-white border-t border-neutral-200 dark:border-neutral-800 pt-6">İşbirliği Seçenekleri</h2>

            <div class="flex flex-col gap-3">
                <div class="flex gap-3 items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0 mt-1.5"></span>
                    <div>
                        <p class="font-bold text-[#111318] dark:text-white text-sm">Banner Reklamı</p>
                        <p>Anasayfa ve kategori sayfalarında görsel reklam alanları.</p>
                    </div>
                </div>
                <div class="flex gap-3 items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0 mt-1.5"></span>
                    <div>
                        <p class="font-bold text-[#111318] dark:text-white text-sm">Sponsorlu İçerik</p>
                        <p>Markanızın mesajını editoryal formatla harmanlayan, açıkça etiketlenmiş sponsorlu yazılar.</p>
                    </div>
                </div>
                <div class="flex gap-3 items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0 mt-1.5"></span>
                    <div>
                        <p class="font-bold text-[#111318] dark:text-white text-sm">Bülten Sponsorluğu</p>
                        <p>Günlük e-posta bültenimizde markanıza özel alan.</p>
                    </div>
                </div>
                <div class="flex gap-3 items-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0 mt-1.5"></span>
                    <div>
                        <p class="font-bold text-[#111318] dark:text-white text-sm">Özel İçerik Ortaklığı</p>
                        <p>Uzun vadeli içerik üretim ve dağıtım ortaklıkları.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 p-6 mt-4">
            <h3 class="font-display font-bold text-[#111318] dark:text-white mb-2">Teklif Alın</h3>
            <p class="text-sm mb-4">Reklam ve işbirliği teklifleriniz için bizimle iletişime geçin.</p>
            <a href="mailto:gazetarycom@gmail.com"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-widest hover:bg-blue-700 transition-colors">
                <span class="material-symbols-outlined text-[16px]">mail</span>
                gazetarycom@gmail.com
            </a>
        </div>

    </div>
</div>
