@model dynamic

@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="tr">
@await Component.InvokeAsync("_UIHeadComponentPartial")

<body class="bg-background-light dark:bg-background-dark font-display text-[#111318] dark:text-white min-h-screen flex flex-col items-center overflow-x-hidden">
<div class="w-full max-w-[1120px] bg-white dark:bg-[#151a23] min-h-screen shadow-sm border-x border-neutral-200 dark:border-neutral-800 flex flex-col mx-auto">
    @await Component.InvokeAsync("_UIHeaderComponentPartial")
    <main class="flex-1 px-4 md:px-8 py-8">
        @RenderBody()
    </main>
    @await Component.InvokeAsync("_UIFooterComponentPartial")
</div>
@RenderSection("scripts", required: false)
</body>
</html>