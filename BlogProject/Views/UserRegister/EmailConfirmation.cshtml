@model BlogProject.Dtos.EmailConfirmationDto

@{
    Layout = "~/Views/UILayout/Index.cshtml";
    var email = TempData["Email"]?.ToString();
    TempData.Keep("Email");
}

<main class="flex-grow flex flex-col items-center py-16 px-4 sm:px-6">
    <div class="w-full max-w-[420px] flex flex-col">

        <div class="text-center mb-10">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-white dark:text-black text-3xl">mail</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#111318] dark:text-white tracking-tight leading-tight mb-3">
                E-postanızı Doğrulayın
            </h2>
            <p class="text-[17px] leading-normal text-gray-600 dark:text-gray-400 font-display">
                @if (!string.IsNullOrEmpty(email))
                {
                    <span><strong class="text-[#111318] dark:text-white">@email</strong> adresine 6 haneli doğrulama kodu gönderdik.</span>
                }
                else
                {
                    <span>E-posta adresinize 6 haneli doğrulama kodu gönderdik.</span>
                }
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="flex items-center gap-3 px-4 py-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded mb-6">
                <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">check_circle</span>
                <p class="text-sm font-sans text-green-700 dark:text-green-400">@TempData["SuccessMessage"]</p>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="flex items-center gap-3 px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded mb-6">
                <span class="material-symbols-outlined text-red-600 text-[20px] shrink-0">error</span>
                <p class="text-sm font-sans text-red-700 dark:text-red-400">@TempData["ErrorMessage"]</p>
            </div>
        }

        <form method="post" class="flex flex-col gap-6">
            @Html.AntiForgeryToken()

            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase">
                    Doğrulama Kodu
                </label>

                <div class="flex gap-2 justify-between" id="codeInputs">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit w-full h-14 text-center text-2xl font-bold border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none rounded font-sans" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit w-full h-14 text-center text-2xl font-bold border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none rounded font-sans" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit w-full h-14 text-center text-2xl font-bold border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none rounded font-sans" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit w-full h-14 text-center text-2xl font-bold border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none rounded font-sans" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit w-full h-14 text-center text-2xl font-bold border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none rounded font-sans" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit w-full h-14 text-center text-2xl font-bold border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none rounded font-sans" />
                </div>

                <input type="hidden" asp-for="Code" id="hiddenCode" />
                <span asp-validation-for="Code" class="text-red-500 text-sm font-sans"></span>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm font-sans" })

            <button type="submit"
                    class="group mt-2 w-full h-12 bg-black dark:bg-white text-white dark:text-black rounded text-sm font-bold tracking-widest uppercase hover:bg-gray-800 dark:hover:bg-gray-200 transition-all font-sans flex items-center justify-center gap-2">
                <span>Doğrula</span>
                <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </button>
        </form>

        <div class="relative my-8">
            <div aria-hidden="true" class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
            </div>
            <div class="relative flex justify-center">
                <span class="bg-white dark:bg-[#1a202c] px-3 text-sm text-gray-500 font-sans italic">kodu almadınız mı?</span>
            </div>
        </div>

        <form method="post" action="/UserRegister/ResendCode">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="w-full h-12 border border-gray-300 dark:border-gray-600 text-[#111318] dark:text-white rounded text-sm font-bold tracking-widest uppercase hover:border-black dark:hover:border-white transition-all font-sans flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-lg">refresh</span>
                <span>Kodu Tekrar Gönder</span>
            </button>
        </form>

        <div class="mt-4 text-center">
            <a href="/UserRegister/Register"
               class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors font-sans flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                Kayda Dön
            </a>
        </div>

    </div>
</main>

<script>
    const digits = document.querySelectorAll('.code-digit');
    const hidden = document.getElementById('hiddenCode');

    digits.forEach((input, index) => {

        input.addEventListener('input', (e) => {
            const val = e.target.value.replace(/\D/g, '');
            e.target.value = val;

            if (val && index < digits.length - 1) {
                digits[index + 1].focus();
            }

            updateHidden();
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !input.value && index > 0) {
                digits[index - 1].focus();
                digits[index - 1].value = '';
                updateHidden();
            }
        });

        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const pasted = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 6);
            pasted.split('').forEach((char, i) => {
                if (digits[i]) digits[i].value = char;
            });
            const last = Math.min(pasted.length, digits.length - 1);
            digits[last].focus();
            updateHidden();
        });
    });

    function updateHidden() {
        hidden.value = [...digits].map(d => d.value).join('');
    }

    digits[0].focus();
</script>
