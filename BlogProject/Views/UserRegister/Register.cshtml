@model BlogProject.Dtos.RegisterDto

@{
    Layout = "~/Views/UILayout/Index.cshtml";
}

<main class="flex-grow flex flex-col items-center py-16 px-4 sm:px-6">
    <div class="w-full max-w-[420px] flex flex-col">
        <!-- Register Headline -->
        <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-[#111318] dark:text-white tracking-tight leading-tight mb-3">Kayıt Olun</h2>
            <p class="text-[17px] leading-normal text-gray-600 dark:text-gray-400 font-display">
                Türkiye'nin en güvenilir haber kaynağına üye olun.
            </p>
        </div>
        <form method="post" class="flex flex-col gap-6">
            <!-- Ad Soyad -->
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="namesurname">Ad Soyad</label>
                <input required asp-for="NameSurname" class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans" id="namesurname" placeholder="Adınız Soyadınız" type="text"/>
                <span asp-validation-for="NameSurname" class="text-red-500 text-sm font-sans"></span>
            </div>
            <!-- E-posta -->
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="email">E-posta Adresi</label>
                <input required asp-for="Email" class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans" id="email" placeholder="ornek@eposta.com" type="email"/>
                <span asp-validation-for="Email" class="text-red-500 text-sm font-sans"></span>
            </div>
            <!-- Şifre -->
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="password">Şifre</label>
                <div class="relative">
                    <input required asp-for="Password" class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans" id="password" placeholder="••••••••" type="password"/>
                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black dark:hover:text-white transition-colors" type="button" onclick="togglePassword('password', this)">
                        <span class="material-symbols-outlined text-[20px] select-none">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-red-500 text-sm font-sans"></span>
            </div>
            <!-- Şifre Tekrar -->
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="confirmPassword">Şifre Tekrar</label>
                <div class="relative">
                    <input required  asp-for="ConfirmPassword" class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans" id="confirmPassword" placeholder="••••••••" type="password"/>
                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black dark:hover:text-white transition-colors" type="button" onclick="togglePassword('confirmPassword', this)">
                        <span class="material-symbols-outlined text-[20px] select-none">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm font-sans"></span>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm font-sans" })

            <button class="group mt-2 w-full h-12 bg-black dark:bg-white text-white dark:text-black rounded text-sm font-bold tracking-widest uppercase hover:bg-gray-800 dark:hover:bg-gray-200 transition-all font-sans flex items-center justify-center gap-2" type="submit">
                <span>Kayıt Ol</span>
                <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </button>
        </form>
        <!-- Divider -->
        <div class="relative my-8">
            <div aria-hidden="true" class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
            </div>
            <div class="relative flex justify-center">
                <span class="bg-white dark:bg-[#1a202c] px-3 text-sm text-gray-500 font-sans italic">veya devam edin</span>
            </div>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-700 rounded text-center">
            <p class="text-base text-gray-800 dark:text-gray-200 font-display">
                Zaten hesabınız var mı?
                <br class="sm:hidden"/>
                <a class="text-primary font-bold hover:underline decoration-2 underline-offset-2 ml-1" href="~/UserLogin/Login">Giriş Yapın</a>
            </p>
        </div>
    </div>
</main>


    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>