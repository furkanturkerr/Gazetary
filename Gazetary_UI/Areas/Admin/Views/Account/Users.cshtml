@model BlogProject.Areas.Admin.Models.UserListViewModel

@{
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><span class="text-muted fw-light">Kullanıcılar / </span>Kullanıcı Listesi</h4>
    <a href="/Admin/Account/CreateUser" class="btn btn-primary btn-sm">
        <i class="bx bx-user-plus me-1"></i> Yeni Admin Ekle
    </a>
</div>

<div class="card">
    <div class="card-header p-0 border-bottom" style="position:relative; z-index:1">
        <ul class="nav nav-tabs card-header-tabs px-3" id="userTabs">
            <li class="nav-item">
                <button type="button" class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#admins">
                    <i class="bx bx-shield me-1"></i> Adminler
                    <span class="badge bg-label-primary ms-1">@Model.Admins.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#users">
                    <i class="bx bx-group me-1"></i> Kullanıcılar
                    <span class="badge bg-label-secondary ms-1">@Model.Users.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="admins">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kullanıcı</th>
                            <th>E-posta</th>
                            <th>Rol</th>
                            <th class="text-end" style="width:100px">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Admins)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar" style="width:36px;height:36px;background:#f0f4ff;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                            <span class="fw-bold text-primary" style="font-size:13px">
                                                @user.NameSurname.Substring(0, 1).ToUpper()
                                            </span>
                                        </div>
                                        <div>
                                            <span class="fw-semibold d-block">@user.NameSurname</span>
                                            <small class="text-muted">@user.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td><span class="badge bg-label-primary">Admin</span></td>
                                <td class="text-end">
                                    <form method="post" action="/Admin/Account/DeleteUser" style="display:inline"
                                          onsubmit="return confirm('Bu admini silmek istediğinizden emin misiniz?')">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-icon btn-outline-danger" title="Sil">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Admins.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bx bx-shield fs-2 d-block mb-2 opacity-50"></i>
                                    Admin bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="users">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kullanıcı</th>
                            <th>E-posta</th>
                            <th>E-posta Doğrulama</th>
                            <th>Rol</th>
                            <th class="text-end" style="width:100px">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar" style="width:36px;height:36px;background:#f5f5f5;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                            <span class="fw-bold text-muted" style="font-size:13px">
                                                @user.NameSurname.Substring(0, 1).ToUpper()
                                            </span>
                                        </div>
                                        <div>
                                            <span class="fw-semibold d-block">@user.NameSurname</span>
                                            <small class="text-muted">@user.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-label-success">
                                            <i class="bx bx-check me-1"></i>Doğrulandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-warning">
                                            <i class="bx bx-time me-1"></i>Bekliyor
                                        </span>
                                    }
                                </td>
                                <td><span class="badge bg-label-secondary">User</span></td>
                                <td class="text-end">
                                    <form method="post" action="/Admin/Account/DeleteUser" style="display:inline"
                                          onsubmit="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?')">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-icon btn-outline-danger" title="Sil">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bx bx-group fs-2 d-block mb-2 opacity-50"></i>
                                    Kullanıcı bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
