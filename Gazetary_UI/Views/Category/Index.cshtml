@model List<Entities.Concrate.BlogPost>

@{
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="w-full md:w-[760px] flex flex-col gap-8">
            <!-- Category Title -->
            <div class="flex flex-col gap-2 border-b border-neutral-200 dark:border-neutral-700 pb-4">
                <div class="flex items-baseline gap-3">
                    <h2 class="text-4xl font-black text-[#111318] dark:text-white tracking-tight uppercase">@ViewBag.CategoryName</h2>
                    <span class="h-px bg-neutral-300 flex-1"></span>
                </div>
                <p class="text-neutral-500 dark:text-neutral-400 text-sm font-sans">Türkiye'den son dakika haberleri, siyaset kulisleri ve özel dosyalar.</p>
            </div>
            <div class="flex flex-col gap-8">
                @foreach (var item in Model)
                {
                    <a href="/@item.Category.CategorySlug/@item.Slug" class="flex flex-col sm:flex-row gap-6 group cursor-pointer border-b border-neutral-100 dark:border-neutral-800 pb-8 last:border-0">
                        <div class="w-full sm:w-[240px] shrink-0 aspect-[4/3] sm:h-[160px] overflow-hidden rounded bg-neutral-100">
                            <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('@item.ImageUrl');"></div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center gap-2 text-xs text-neutral-500 font-sans">
                                <span class="font-bold text-primary">@item.Category.CategoryName</span>
                                <span>•</span>
                                <span>DHA</span>
                                <span>•</span>
                                <span>@item.CreatedDate.ToString("hh:mm - dd/MMM/yyyy")</span>
                            </div>
                            <h4 class="text-xl font-bold text-[#111318] dark:text-white leading-snug group-hover:text-primary transition-colors">
                                @item.Title
                            </h4>
                            <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed line-clamp-2">
                                @item.Description
                            </p>
                        </div>
                    </a>
                }
                
                
                @if (ViewBag.Pagesize >= 5)
                {
                    <div class="flex items-center gap-2 mt-6">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <a href="/@ViewBag.CategorySlug?page=@(ViewBag.CurrentPage - 1)"
                               class="px-4 py-2 rounded border border-neutral-200 dark:border-neutral-700 text-sm font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
                                ← Önceki
                            </a>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <a href="/@ViewBag.CategorySlug?page=@i"
                               class="px-4 py-2 rounded border text-sm font-semibold transition
                  @(i == ViewBag.CurrentPage
                      ? "bg-primary text-white border-primary"
                      : "border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800")">
                                @i
                            </a>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <a href="/@ViewBag.CategorySlug?page=@(ViewBag.CurrentPage + 1)"
                               class="px-4 py-2 rounded border border-neutral-200 dark:border-neutral-700 text-sm font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
                                Sonraki →
                            </a>
                        }
                    </div>
                }
            </div>
        </div>