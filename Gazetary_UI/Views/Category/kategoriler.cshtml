@model List<Entities.Concrate.Category>

@{
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="w-full md:w-[760px] flex flex-col gap-10">

    <div class="flex items-center gap-4 border-b border-neutral-300 dark:border-neutral-700 pb-5">
        <h2 class="text-4xl font-black tracking-tight uppercase text-[#111318] dark:text-white">
            Tüm Kategoriler
        </h2>
        <span class="flex-1 h-px bg-neutral-300 dark:bg-neutral-700"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">

        @foreach (var item in Model)
        {
            <a asp-controller="Category"
               asp-action="Index"
               asp-route-categorySlug="@item.CategorySlug"
               class="group border border-neutral-200 dark:border-neutral-800 p-6 rounded-lg hover:shadow-lg transition-all duration-300 bg-white dark:bg-[#111318] hover:-translate-y-1">

                <div class="flex items-center justify-between mb-4">

                    <span class="text-xs uppercase tracking-widest text-neutral-500">
                        Kategori
                    </span>

                    <span class="text-sm font-bold text-primary group-hover:scale-110 transition">
                        →
                    </span>

                </div>

                <h3 class="text-2xl font-extrabold text-[#111318] dark:text-white group-hover:text-primary transition-colors">
                    @item.CategoryName
                </h3>

                <div class="mt-4 flex items-center justify-between text-sm text-neutral-500">

                    <span>
                        @item.BlogPosts?.Count() 0 Yazı
                    </span>

                    <span class="text-xs uppercase tracking-wide">
                        İncele
                    </span>

                </div>

            </a>
        }

    </div>
</div>
