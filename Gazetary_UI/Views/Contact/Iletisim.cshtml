@model Entities.Concrate.Contact
@{
    Layout = "~/Views/UILayout/Home.cshtml";
    ViewBag.Title = "İletişim";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="max-w-5xl mx-auto py-12 px-4">

    <!-- HEADER -->
    <div class="border-b-2 border-black dark:border-white pb-3 mb-10">
        <p class="text-[10px] font-sans font-bold uppercase tracking-widest text-primary mb-1">
            Kurumsal
        </p>
        <h1 class="text-4xl font-display font-bold text-[#111318] dark:text-white">
            İletişim
        </h1>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-2">
            Sorularınız, iş birlikleri veya geri bildirimleriniz için bize ulaşabilirsiniz.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 px-4 py-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 mb-6 rounded-lg">
            <span class="material-symbols-outlined text-green-600 text-[20px]">check_circle</span>
            <p class="text-sm text-green-700 dark:text-green-400">@TempData["Success"]</p>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

        <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 rounded-xl shadow-sm">

            <h2 class="text-lg font-bold mb-2 text-[#111318] dark:text-white">
                Bize Yazın
            </h2>

            <form method="post" asp-controller="Contact" asp-action="Iletisim" class="flex flex-col gap-4">

                <input type="text" asp-for="NameSurname" required
                       placeholder="Adınız ve soyadınız"
                       class="w-full px-3 py-2.5 border rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />

                <input type="email" asp-for="Email" required
                       placeholder="ornek@mail.com"
                       class="w-full px-3 py-2.5 border rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />

                <select asp-for="Subject"
                        class="w-full px-3 py-2.5 border rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition">
                    <option value="">Konu seçin</option>
                    <option value="genel">Genel</option>
                    <option value="icerik">İçerik Önerisi</option>
                    <option value="reklam">Reklam & İşbirliği</option>
                    <option value="duzeltme">Düzeltme Talebi</option>
                    <option value="diger">Diğer</option>
                </select>

                <textarea asp-for="Message" required rows="5"
                          placeholder="Mesajınızı yazın..."
                          class="w-full px-3 py-2.5 border rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition resize-none"></textarea>

                <button type="submit"
                        class="w-full py-3 bg-primary text-white text-xs font-bold uppercase tracking-widest rounded-lg hover:bg-blue-700 transition-all duration-200 shadow-md hover:shadow-lg">
                    Gönder
                </button>

            </form>
        </div>

        <!-- SAĞ TARAF -->
        <div class="flex flex-col gap-6">

            <!-- INFO CARD -->
            <div class="bg-neutral-50 dark:bg-neutral-900/40 p-6 border border-neutral-200 dark:border-neutral-800 rounded-xl">

                <h2 class="text-lg font-bold mb-3 text-[#111318] dark:text-white">
                    İletişim Bilgileri
                </h2>

                <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-5 leading-relaxed">
                    Gazetary ile iletişime geçmek için aşağıdaki kanalları kullanabilirsiniz.
                    İş birlikleri ve içerik önerileri için bize ulaşın.
                </p>

                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-[20px] mt-0.5">mail</span>
                    <div>
                        <p class="text-[10px] font-bold uppercase text-neutral-400">E-posta</p>
                        <a href="mailto:gazetarycom@gmail.com"
                           class="text-sm hover:text-primary transition">
                            gazetarycom@gmail.com
                        </a>
                    </div>
                </div>

            </div>

            @* <!-- SOCIAL --> *@
            @* <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 rounded-xl"> *@
            @* *@
            @*     <p class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 mb-4"> *@
            @*         Sosyal Medya *@
            @*     </p> *@
            @* *@
            @*     <div class="flex gap-3"> *@
            @* *@
            @*         <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border hover:bg-black hover:text-white transition"> *@
            @*             <i class="fa-brands fa-x-twitter"></i> *@
            @*         </a> *@
            @* *@
            @*         <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border hover:bg-pink-500 hover:text-white transition"> *@
            @*             <i class="fa-brands fa-instagram"></i> *@
            @*         </a> *@
            @* *@
            @*         <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border hover:bg-red-600 hover:text-white transition"> *@
            @*             <i class="fa-brands fa-youtube"></i> *@
            @*         </a> *@
            @* *@
            @*         <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border hover:bg-orange-500 hover:text-white transition"> *@
            @*             <span class="material-symbols-outlined">rss_feed</span> *@
            @*         </a> *@
            @* *@
            @*     </div> *@
            @* *@
            @* </div> *@

        </div>

    </div>
</div>

@if (TempData["Basarili"] != null)
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: "top-end",
            showConfirmButton: false,
            timer: 3000
        });

        Toast.fire({
            icon: "success",
            title: "@TempData["Basarili"]"
        });
    </script>
}