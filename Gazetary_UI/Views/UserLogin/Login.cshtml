@model BlogProject.Dtos.LoginDto

@{
    Layout = "~/Views/UILayout/Index.cshtml";
}

<main class="flex-grow flex flex-col items-center py-16 px-4 sm:px-6">
    <div class="w-full max-w-[420px] flex flex-col">
        <!-- Login Headline -->
        <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-[#111318] dark:text-white tracking-tight leading-tight mb-3">Oturum Açın</h2>
            <p class="text-[17px] leading-normal text-gray-600 dark:text-gray-400 font-display">
                Türkiye'nin en güvenilir haber kaynağına erişmek için giriş yapın.
            </p>
        </div>
        <form method="Post" class="flex flex-col gap-6">
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="email">E-posta Adresi</label>
                <input asp-for="Email" class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans" id="email" placeholder="ornek@eposta.com" type="email"/>
            </div>
            <div class="space-y-1.5">
                <div class="flex justify-between items-center">
                    <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="password">Şifre</label>
                    <a class="text-sm text-gray-500 hover:text-primary dark:text-gray-400 transition-colors font-sans font-medium" href="~/UserRegister/ForgotPassword">Şifremi Unuttum</a>
                </div>
                <div class="relative">
                    <input asp-for="Password" class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans" id="password" placeholder="••••••••" type="password"/>
                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black dark:hover:text-white transition-colors" type="button">
                        <span class="material-symbols-outlined text-[20px] select-none">visibility</span>
                    </button>
                </div>
            </div>
            <button class="group mt-2 w-full h-12 bg-black dark:bg-white text-white dark:text-black rounded text-sm font-bold tracking-widest uppercase hover:bg-gray-800 dark:hover:bg-gray-200 transition-all font-sans flex items-center justify-center gap-2" type="submit">
                <span>Giriş Yap</span>
                <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </button>
            @Html.ValidationSummary(false, "", new { @class = "text-red-500 text-sm font-sans" })
        </form>
        <!-- Divider -->
        <div class="relative my-8">
            <div aria-hidden="true" class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
            </div>
            <div class="relative flex justify-center">
                <span class="bg-white dark:bg-[#1a202c] px-3 text-sm text-gray-500 font-sans italic">veya devam edin</span>
            </div>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-700 rounded text-center">
            <p class="text-base text-gray-800 dark:text-gray-200 font-display">
                Henüz hesabınız yok mu?
                <br class="sm:hidden"/>
                <a class="text-primary font-bold hover:underline decoration-2 underline-offset-2 ml-1" asp-controller="UserRegister" asp-action="Register">Abone Olun ve Kayıt Yapın</a>
            </p>
        </div>
    </div>
</main>


