@model Dtos.ResetPasswordDto

@{
    Layout = "~/Views/UILayout/Index.cshtml";
}

<main class="flex-grow flex flex-col items-center py-16 px-4 sm:px-6">
    <div class="w-full max-w-[420px] flex flex-col">

        <div class="text-center mb-10">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-white dark:text-black text-3xl">lock</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#111318] dark:text-white tracking-tight leading-tight mb-3">
                Yeni Şifre
            </h2>
            <p class="text-[17px] leading-normal text-gray-600 dark:text-gray-400 font-display">
                Hesabınız için yeni bir şifre belirleyin.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="flex items-center gap-3 px-4 py-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded mb-6">
                <span class="material-symbols-outlined text-green-600 text-[20px] shrink-0">check_circle</span>
                <p class="text-sm font-sans text-green-700 dark:text-green-400">@TempData["SuccessMessage"]</p>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="flex items-center gap-3 px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded mb-6">
                <span class="material-symbols-outlined text-red-600 text-[20px] shrink-0">error</span>
                <p class="text-sm font-sans text-red-700 dark:text-red-400">@TempData["ErrorMessage"]</p>
            </div>
        }

        <form method="post" class="flex flex-col gap-6">
            @Html.AntiForgeryToken()

            <!-- Yeni Şifre -->
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="newPassword">
                    Yeni Şifre
                </label>
                <div class="relative">
                    <input required asp-for="NewPassword"
                           class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans"
                           id="newPassword" placeholder="••••••••" type="password" />
                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black dark:hover:text-white transition-colors" type="button"
                            onclick="togglePassword('newPassword', this)">
                        <span class="material-symbols-outlined text-[20px] select-none">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-red-500 text-sm font-sans"></span>
            </div>

            <!-- Şifre Tekrar -->
            <div class="space-y-1.5">
                <label class="block text-sm font-bold text-[#111318] dark:text-gray-200 font-sans tracking-wide uppercase" for="confirmNewPassword">
                    Şifre Tekrar
                </label>
                <div class="relative">
                    <input required asp-for="ConfirmNewPassword"
                           class="block w-full h-12 px-4 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black dark:focus:ring-white transition-all outline-none font-sans"
                           id="confirmNewPassword" placeholder="••••••••" type="password" />
                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black dark:hover:text-white transition-colors" type="button"
                            onclick="togglePassword('confirmNewPassword', this)">
                        <span class="material-symbols-outlined text-[20px] select-none">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-red-500 text-sm font-sans"></span>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm font-sans" })

            <button type="submit"
                    class="group mt-2 w-full h-12 bg-black dark:bg-white text-white dark:text-black rounded text-sm font-bold tracking-widest uppercase hover:bg-gray-800 dark:hover:bg-gray-200 transition-all font-sans flex items-center justify-center gap-2">
                <span>Şifremi Sıfırla</span>
                <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="/UserLogin/Login"
               class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors font-sans flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                Girişe Dön
            </a>
        </div>

    </div>
</main>

<script>
    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('.material-symbols-outlined');
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }
</script>
